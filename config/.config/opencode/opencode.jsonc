{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "magpie": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://must77.me:9500/v1",
        "apiKey": "REPLACE_WITH_YOUR_MAGPIE_KEY"
      },
      "models": {
        "group/glm-5.3": {
          "name": "glm-5.3",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          },
          "body": {
            "thinking": {
              "type": "enabled"
            }
          },
          "variants": [
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        },
