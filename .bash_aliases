alias kimi='command kimi --yolo'
alias codex='command codex --yolo'
alias claude='command claude --dangerously-skip-permissions'
alias cluade='command claude --dangerously-skip-permissions'
alias na='nautilus . &>/dev/null &'
alias no_proxy='unset -v all_proxy http_proxy https_proxy ftp_proxy rsync_proxy no_proxy ALL_PROXY HTTP_PROXY HTTPS_PROXY FTP_PROXY RSYNC_PROXY NO_PROXY'
