#!/usr/bin/env bash
set -Eeuo pipefail

if (( $# == 0 )); then
    sudo apt update
    sudo apt install -y wget curl git htop mc screen tmux ufw vim telnet-ssl bison g++ build-essential openssh-server cmake locate ripgrep fd-find fzf jq bat sd unzip tcpdump net-tools avahi-daemon avahi-utils python3 tree sshpass
    sudo systemctl enable --now ssh

    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
    source "$NVM_DIR/nvm.sh"
    nvm install 22
    npm install -g tldr
    tldr --update
    exit
fi

exec python3 bootstrap_cli.py "$@"
